# Copy to `.env` for local development. Never commit real values.

ENV=local
LOG_LEVEL=INFO

# memory (no GCP needed) | firestore
STORAGE_BACKEND=memory
# inline (local) | pubsub (deployed; required on Cloud Run with request-based CPU)
JOB_BACKEND=inline
# live_first | cache_first | demo_snapshot
DATA_MODE=cache_first

GCP_PROJECT=
GCP_REGION=us-central1
GCS_BUCKET=
BQ_CATALOG_DATASET=catalog

PUBSUB_TOPIC=analysis-jobs
PUBSUB_VERIFY_OIDC=false
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# Gemini via Vertex AI only (free-trial credit does not cover AI Studio keys).
LLM_ENABLED=true
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
LLM_MAX_OUTPUT_TOKENS=1024
COPILOT_MAX_TOOL_CALLS=6

# Distributor APIs (live data, issue #12). Leave blank to disable a provider.
# Locally: put real values in services/api/.env (git-ignored). Deployed: Secret Manager.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# true if the DigiKey app was created in the Sandbox environment
DIGIKEY_SANDBOX=false
MOUSER_API_KEY=
ELEMENT14_API_KEY=
# element14 store domain: in.element14.com (India), uk.farnell.com, www.newark.com (US), ...
ELEMENT14_STORE=in.element14.com
# Master switch for live distributor calls (false = catalog/cache only).
LIVE_DISTRIBUTORS_ENABLED=true
# Check keys and parsing for one part:  uv run python scripts/check_distributors.py RC0603FR-0710KL

CORS_ORIGINS=["http://localhost:3000"]

# Local emulator (optional): gcloud emulators firestore start --host-port=localhost:8681
# FIRESTORE_EMULATOR_HOST=localhost:8681
