# Copy to .env.local for local development.
# API service the /api/v1 proxy forwards to. Use 127.0.0.1 (not localhost) on machines where
# Docker/WSL also listen on [::1]:8080.
API_BASE_URL=http://127.0.0.1:8080
# Cloud Run only: the API service URL, used as the ID-token audience (API stays private).
# API_AUDIENCE=https://quotelens-api-xxxx.a.run.app
