{
  "name": "@quotelens/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "uv run --project ../../services/api python ../../services/api/scripts/export_openapi.py lib/api/openapi.json && openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "openapi-fetch": "^0.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8"
}
